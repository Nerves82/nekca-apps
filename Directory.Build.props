<Project>
  <!-- Settings shared by every project in the solution. -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Company>Northeast Kingdom Community Action (NEKCA)</Company>
    <Product>NEKCA Apps</Product>
    <!-- CI overrides Version with the build number, e.g. 0.1.42 -->
    <Version>0.1.0</Version>
    <!-- CI already puts the short commit id in InformationalVersion; don't append the full one too. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
</Project>
