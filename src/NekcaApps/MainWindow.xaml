<Window x:Class="NekcaApps.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NEKCA Apps" Width="860" Height="720" MinWidth="560" MinHeight="420"
        Icon="nekca.ico" Background="#F3F5F3" WindowStartupLocation="CenterScreen"
        Loaded="OnLoaded">
    <DockPanel>
        <!-- header -->
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource Green}" BorderThickness="0,0,0,3" Padding="20,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="CheckedText" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <Button x:Name="RefreshButton" Content="Check for updates" Click="OnRefresh" Margin="0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Image Source="nekca.ico" Width="32" Height="32" Margin="0,0,10,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="NEKCA Apps" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource Green}" />
                        <TextBlock x:Name="VersionText" Foreground="{StaticResource Muted}" FontSize="11" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- banners: install the launcher itself, update it, or a note about the app list -->
        <StackPanel DockPanel.Dock="Top" Margin="20,12,20,0">
            <Border x:Name="InstallBanner" Visibility="Collapsed" Background="{StaticResource WarnSoft}" CornerRadius="6" Padding="14,10" Margin="0,0,0,8">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="Install NEKCA Apps" Click="OnInstallLauncher" Margin="0" />
                    <TextBlock TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{StaticResource Warn}"
                               Text="NEKCA Apps is running from a download. Install it on this computer to get a Start Menu shortcut and automatic updates." />
                </DockPanel>
            </Border>
            <Border x:Name="UpdateBanner" Visibility="Collapsed" Background="{StaticResource GreenSoft}" CornerRadius="6" Padding="14,10" Margin="0,0,0,8">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="Update now" Click="OnUpdateLauncher" Margin="0" />
                    <TextBlock x:Name="UpdateBannerText" TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
            </Border>
            <TextBlock x:Name="NoteText" Visibility="Collapsed" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,4,20,20">
            <StackPanel>
                <TextBlock x:Name="LoadingText" Text="Loading the app list…" Foreground="{StaticResource Muted}" Margin="0,8" />
                <ItemsControl x:Name="AppList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="18,14" Margin="0,0,0,12">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                                        <Border Style="{StaticResource Tag}" Background="{StaticResource WarnSoft}"
                                                Visibility="{Binding UpdateAvailable, Converter={StaticResource Vis}}">
                                            <TextBlock Text="update available" Foreground="{StaticResource Warn}" FontSize="11" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Description}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                    <TextBlock Text="{Binding StatusText}" Margin="0,8,0,10" TextWrapping="Wrap" />

                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource Primary}" Content="Install" Command="{Binding InstallCommand}"
                                                Visibility="{Binding CanInstall, Converter={StaticResource Vis}}" />
                                        <Button Style="{StaticResource Primary}" Content="{Binding UpdateText}" Command="{Binding UpdateCommand}"
                                                Visibility="{Binding CanUpdate, Converter={StaticResource Vis}}" />
                                        <Button Content="Open" Command="{Binding OpenCommand}"
                                                Visibility="{Binding CanOpen, Converter={StaticResource Vis}}" />
                                        <CheckBox Content="Desktop shortcut" IsChecked="{Binding DesktopShortcut}" VerticalAlignment="Center" Margin="8,0,0,0"
                                                  Visibility="{Binding IsInstalled, Converter={StaticResource Vis}}" />
                                    </StackPanel>

                                    <StackPanel Visibility="{Binding ShowProgress, Converter={StaticResource Vis}}" Margin="0,10,0,0">
                                        <TextBlock Text="{Binding ProgressText}" Foreground="{StaticResource Muted}" Margin="0,0,0,4" />
                                        <ProgressBar Height="6" Value="{Binding ProgressValue, Mode=OneWay}" IsIndeterminate="{Binding ProgressUnknown, Mode=OneWay}"
                                                     Foreground="{StaticResource Green}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{StaticResource Warn}"
                                               Visibility="{Binding HasMessage, Converter={StaticResource Vis}}" />

                                    <Expander Header="All versions" Margin="0,10,0,0" Foreground="{StaticResource Green}">
                                        <StackPanel Margin="0,6,0,0">
                                            <TextBlock Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,6"
                                                       Text="Pick any version to go back to it. The version in use and the one before it stay installed; older ones are removed and can be installed again from here." />
                                            <ItemsControl ItemsSource="{Binding Versions}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,8">
                                                            <DockPanel>
                                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                                                    <Button Content="{Binding UseText}" Command="{Binding UseCommand}" Padding="10,3"
                                                                            Visibility="{Binding CanUse, Converter={StaticResource Vis}}" />
                                                                    <Button Content="Remove" Command="{Binding RemoveCommand}" Padding="10,3" Margin="0"
                                                                            Visibility="{Binding CanRemove, Converter={StaticResource Vis}}" />
                                                                </StackPanel>
                                                                <StackPanel>
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="{Binding Version}" FontWeight="SemiBold" />
                                                                        <TextBlock Text="{Binding Date}" Foreground="{StaticResource Muted}" Margin="10,0,0,0" />
                                                                        <Border Style="{StaticResource Tag}" Background="{StaticResource GreenSoft}"
                                                                                Visibility="{Binding HasTag, Converter={StaticResource Vis}}">
                                                                            <TextBlock Text="{Binding Tag}" Foreground="{StaticResource Green}" FontSize="11" />
                                                                        </Border>
                                                                    </StackPanel>
                                                                    <TextBlock Text="{Binding Changes}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,3,12,0" />
                                                                </StackPanel>
                                                            </DockPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Button Style="{StaticResource Link}" Content="Uninstall this app" Command="{Binding UninstallCommand}" Margin="0,8,0,0"
                                                    HorizontalAlignment="Left" Visibility="{Binding IsInstalled, Converter={StaticResource Vis}}" />
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
