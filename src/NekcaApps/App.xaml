<Application x:Class="NekcaApps.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <BooleanToVisibilityConverter x:Key="Vis" />
        <SolidColorBrush x:Key="Green" Color="#1C5630" />
        <SolidColorBrush x:Key="GreenSoft" Color="#E6F0E8" />
        <SolidColorBrush x:Key="Ink" Color="#1F2A24" />
        <SolidColorBrush x:Key="Muted" Color="#5F6B64" />
        <SolidColorBrush x:Key="Line" Color="#D5DDD7" />
        <SolidColorBrush x:Key="Warn" Color="#8A5A00" />
        <SolidColorBrush x:Key="WarnSoft" Color="#FFF4D6" />

        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="{StaticResource Green}" />
            <Setter Property="BorderBrush" Value="{StaticResource Green}" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Green}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="Link" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource Green}" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock Text="{TemplateBinding Content}" TextDecorations="Underline" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Tag" TargetType="Border">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Application.Resources>
</Application>
